{
	"info": {
		"_postman_id": "clinic-system-v1-full-collection",
		"name": "Clinic Management System API - Complete",
		"description": "Full Postman Collection for Clinic Management System covering all endpoints, RBAC roles, appointments, medical records, schedules, and payments.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://127.0.0.1:8000/api/v1",
			"type": "string"
		},
		{
			"key": "token",
			"value": "",
			"type": "string"
		},
		{
			"key": "user_id",
			"value": "",
			"type": "string"
		},
		{
			"key": "service_id",
			"value": "1",
			"type": "string"
		},
		{
			"key": "doctor_id",
			"value": "2",
			"type": "string"
		},
		{
			"key": "appointment_id",
			"value": "1",
			"type": "string"
		},
		{
			"key": "payment_id",
			"value": "1",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "1. Authentication & Profile",
			"item": [
				{
					"name": "Login - Admin",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.data) {",
									"    if (jsonData.data.token) { pm.collectionVariables.set(\"token\", jsonData.data.token); }",
									"    if (jsonData.data.user && jsonData.data.user.id) { pm.collectionVariables.set(\"user_id\", jsonData.data.user.id); }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{"key": "Accept", "value": "application/json"},
							{"key": "Content-Type", "value": "application/json"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"admin@clinic.com\",\n    \"password\": \"password123\"\n}"
						},
						"url": {"raw": "{{base_url}}/login", "host": ["{{base_url}}"], "path": ["login"]}
					}
				},
				{
					"name": "Login - Doctor",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.data) {",
									"    if (jsonData.data.token) { pm.collectionVariables.set(\"token\", jsonData.data.token); }",
									"    if (jsonData.data.user && jsonData.data.user.id) { pm.collectionVariables.set(\"user_id\", jsonData.data.user.id); }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{"key": "Accept", "value": "application/json"},
							{"key": "Content-Type", "value": "application/json"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"doctor@clinic.com\",\n    \"password\": \"password123\"\n}"
						},
						"url": {"raw": "{{base_url}}/login", "host": ["{{base_url}}"], "path": ["login"]}
					}
				},
				{
					"name": "Login - Patient",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.data) {",
									"    if (jsonData.data.token) { pm.collectionVariables.set(\"token\", jsonData.data.token); }",
									"    if (jsonData.data.user && jsonData.data.user.id) { pm.collectionVariables.set(\"user_id\", jsonData.data.user.id); }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{"key": "Accept", "value": "application/json"},
							{"key": "Content-Type", "value": "application/json"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"patient@clinic.com\",\n    \"password\": \"password123\"\n}"
						},
						"url": {"raw": "{{base_url}}/login", "host": ["{{base_url}}"], "path": ["login"]}
					}
				},
				{
					"name": "Register Patient",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.data && jsonData.data.token) { pm.collectionVariables.set(\"token\", jsonData.data.token); }"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{"key": "Accept", "value": "application/json"},
							{"key": "Content-Type", "value": "application/json"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"first_name\": \"آيه\",\n    \"last_name\": \"برغوث\",\n    \"email\": \"aya.test@clinic.com\",\n    \"password\": \"password123\",\n    \"password_confirmation\": \"password123\"\n}"
						},
						"url": {"raw": "{{base_url}}/register", "host": ["{{base_url}}"], "path": ["register"]}
					}
				},
				{
					"name": "Get Authenticated User Profile",
					"request": {
						"method": "GET",
						"header": [
							{"key": "Accept", "value": "application/json"},
							{"key": "Authorization", "value": "Bearer {{token}}"}
						],
						"url": {"raw": "{{base_url}}/user", "host": ["{{base_url}}"], "path": ["user"]}
					}
				},
				{
					"name": "Logout",
					"request": {
						"method": "POST",
						"header": [
							{"key": "Accept", "value": "application/json"},
							{"key": "Authorization", "value": "Bearer {{token}}"}
						],
						"url": {"raw": "{{base_url}}/logout", "host": ["{{base_url}}"], "path": ["logout"]}
					}
				}
			]
		},
		{
			"name": "2. Services Management",
			"item": [
				{
					"name": "Get All Services (Public)",
					"request": {
						"method": "GET",
						"header": [{"key": "Accept", "value": "application/json"}],
						"url": {"raw": "{{base_url}}/services", "host": ["{{base_url}}"], "path": ["services"]}
					}
				},
				{
					"name": "Create Service (Admin)",
					"request": {
						"method": "POST",
						"header": [
							{"key": "Accept", "value": "application/json"},
							{"key": "Content-Type", "value": "application/json"},
							{"key": "Authorization", "value": "Bearer {{token}}"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"تبييض أسنان بالليزر\",\n    \"description\": \"إزالة البقع والتبييض الفعال باستخدام تقنية الليزر\",\n    \"price\": 500.00,\n    \"duration_minutes\": 60,\n    \"is_active\": true\n}"
						},
						"url": {"raw": "{{base_url}}/services", "host": ["{{base_url}}"], "path": ["services"]}
					}
				},
				{
					"name": "Update Service (Admin)",
					"request": {
						"method": "PUT",
						"header": [
							{"key": "Accept", "value": "application/json"},
							{"key": "Content-Type", "value": "application/json"},
							{"key": "Authorization", "value": "Bearer {{token}}"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"تبييض أسنان مدمج\",\n    \"description\": \"تعديل الوصف والسعر\",\n    \"price\": 450.00,\n    \"duration_minutes\": 45,\n    \"is_active\": true\n}"
						},
						"url": {"raw": "{{base_url}}/services/{{service_id}}", "host": ["{{base_url}}"], "path": ["services", "{{service_id}}"]}
					}
				},
				{
					"name": "Delete Service (Admin)",
					"request": {
						"method": "DELETE",
						"header": [
							{"key": "Accept", "value": "application/json"},
							{"key": "Authorization", "value": "Bearer {{token}}"}
						],
						"url": {"raw": "{{base_url}}/services/{{service_id}}", "host": ["{{base_url}}"], "path": ["services", "{{service_id}}"]}
					}
				}
			]
		},
