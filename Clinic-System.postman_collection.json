							"raw": "{\n    \"doctor_id\": {{doctor_id}},\n    \"service_id\": {{service_id}},\n    \"appointment_date\": \"2026-10-25\",\n    \"appointment_time\": \"10:30\",\n    \"notes\": \"أعاني من ألم في الضرس العلوي\"\n}"
