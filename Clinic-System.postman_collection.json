        {
	"name": "8. Doctor Services & Specialization",
	"item": [
		{
			"name": "Assign Services to Doctor",
			"request": {
				"method": "POST",
				"header": [
					{"key": "Accept", "value": "application/json"},
					{"key": "Content-Type", "value": "application/json"},
					{"key": "Authorization", "value": "Bearer {{token}}"}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"services\": [\n        {\n            \"service_id\": 1,\n            \"custom_price\": 120.00\n        },\n        {\n            \"service_id\": 2,\n            \"custom_price\": null\n        }\n    ]\n}"
				},
				"url": {
					"raw": "{{base_url}}/doctors/{{doctor_id}}/services",
					"host": ["{{base_url}}"],
					"path": ["doctors", "{{doctor_id}}", "services"]
				}
			}
		},
		{
			"name": "Get Doctors by Service ID (For Patients)",
			"request": {
				"method": "GET",
				"header": [
					{"key": "Accept", "value": "application/json"}
				],
				"url": {
					"raw": "{{base_url}}/services/{{service_id}}/doctors",
					"host": ["{{base_url}}"],
					"path": ["services", "{{service_id}}", "doctors"]
				}
			}
		},
		{
			"name": "Get Services of Specific Doctor",
			"request": {
				"method": "GET",
				"header": [
					{"key": "Accept", "value": "application/json"}
				],
				"url": {
					"raw": "{{base_url}}/doctors/{{doctor_id}}/services",
					"host": ["{{base_url}}"],
					"path": ["doctors", "{{doctor_id}}", "services"]
